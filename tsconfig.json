{
  // Visit https://aka.ms/tsconfig to read more about this file
    "compilerOptions": {
    "target": "ES2022",                          /* Set the JavaScript language version */
    "module": "NodeNext",                        /* Specify module code generation */
    "moduleResolution": "NodeNext",              /* Determine how modules get resolved */
    "rootDir": "./src",                          /* Specify the root folder of source files */
    "outDir": "./dist",                          /* Redirect output structure to the directory */
    "esModuleInterop": true,                      /* Emit additional JavaScript to ease importing CommonJS modules */
    "forceConsistentCasingInFileNames": true,  /* Ensure that casing is correct in imports */
    "strict": true,                              /* Enable all strict type-checking options */
    "skipLibCheck": true,
  },
  "exclude": ["node_modules", "prisma.config.ts", "tests"]                         /* Skip type checking of declaration files */
}
